+def _mhc_bf16_weights_enabled() -> bool:
+    """The fused mHC decode kernel may read exact BF16 copies of hc_*_fn.
+
+    The checkpoint stores them in BF16; VLLM_GLM53_MHC_BF16W=0 keeps FP32.
+    """
+    import os
+
+    return current_platform.is_cuda() and os.environ.get(
+        "VLLM_GLM53_MHC_BF16W", "1"
+    ) != "0"
+
+
