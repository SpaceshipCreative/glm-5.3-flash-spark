diff --git a/vllm/model_executor/kernels/mhc/tilelang.py b/vllm/model_executor/kernels/mhc/tilelang.py
index 62741bbda..7976727a9 100644
--- a/vllm/model_executor/kernels/mhc/tilelang.py
+++ b/vllm/model_executor/kernels/mhc/tilelang.py
@@ -5,6 +5,65 @@ import torch
 from vllm.utils.math_utils import cdiv
 from vllm.utils.torch_utils import direct_register_custom_op
 
+# FP32 mHC projection weights (by data_ptr) whose values BF16 holds exactly,
+# mapped to that BF16 copy. The fused decode kernel then reads half the bytes
+# for the same result. Filled by register_mhc_bf16_weights; GLM-5.3 only.
+_MHC_BF16_WEIGHTS: dict[int, torch.Tensor] = {}
+
+
+def register_mhc_bf16_weights(fns: list[torch.Tensor]) -> int:
+    """Give each FP32 ``fn`` that BF16 represents exactly a BF16 copy.
+
+    Call after loading, outside CUDA graph capture. Before any copy is used,
+    the BF16-weight kernel must match the FP32 one bit for bit on the first
+    such weight; otherwise nothing is registered. Returns the number of
+    weights registered.
+    """
+    twins = {}
+    for fn in fns:
+        if not fn.is_cuda or fn.dtype != torch.float32 or not fn.is_contiguous():
+            continue
+        twin = fn.detach().to(torch.bfloat16)
+        if torch.equal(twin.float(), fn):
+            twins[fn.data_ptr()] = (fn, twin)
+    if not twins or not _bf16_weight_kernel_matches(*next(iter(twins.values()))):
+        return 0
+    # ponytail: keyed by data_ptr, so a reload must call this again.
+    _MHC_BF16_WEIGHTS.update({ptr: twin for ptr, (_, twin) in twins.items()})
+    return len(twins)
+
+
+def _bf16_weight_kernel_matches(fn: torch.Tensor, twin: torch.Tensor) -> bool:
+    from vllm.model_executor.kernels.mhc.tilelang_kernels import (
+        _FUSED_POST_PRE_MAX_TOKENS,
+        _MHC_FUSED_BF16W_TILELANG_KERNEL,
+        _MHC_FUSED_TILELANG_KERNEL,
+    )
+
+    mix_size, input_size = fn.shape
+    hc_mult = int((mix_size + 1) ** 0.5) - 1
+    hidden_size = input_size // hc_mult
+    gen = torch.Generator(device=fn.device).manual_seed(0)
+    for m in sorted({1, 3, 16, _FUSED_POST_PRE_MAX_TOKENS}):
+        args = (
+            torch.rand(m, hc_mult, hc_mult, device=fn.device, generator=gen),
+            torch.randn(m, hc_mult, hidden_size, device=fn.device, generator=gen)
+            .to(torch.bfloat16),
+            torch.rand(m, hc_mult, device=fn.device, generator=gen),
+            torch.randn(m, hidden_size, device=fn.device, generator=gen)
+            .to(torch.bfloat16),
+        )
+        shape = (mix_size, hc_mult, hidden_size)
+        ref = _MHC_FUSED_TILELANG_KERNEL(
+            *args, fn.view(shape), hc_mult, hidden_size, mix_size
+        )
+        out = _MHC_FUSED_BF16W_TILELANG_KERNEL(
+            *args, twin.view(shape), hc_mult, hidden_size, mix_size
+        )
+        if not all(torch.equal(a, b) for a, b in zip(ref, out)):
+            return False
+    return True
+
 
 def _torch_hc_prenorm_gemm(
     x: torch.Tensor,
@@ -846,6 +905,7 @@ def mhc_fused_post_pre_tilelang(
 
     """
     from vllm.model_executor.kernels.mhc.tilelang_kernels import (
+        _MHC_FUSED_BF16W_TILELANG_KERNEL,
