     def __init__(
         self,
@@ -456,6 +468,16 @@ class Glm5NextDecoderLayer(nn.Module):
                     hidden_size=self.hidden_size,
                     hc_mult=self.n,
                 )
+                if _mhc_bf16_weights_enabled():
+                    from vllm.model_executor.kernels.mhc.tilelang_kernels import (
+                        _MHC_FUSED_BF16W_TILELANG_KERNEL,
+                    )
+
+                    _MHC_FUSED_BF16W_TILELANG_KERNEL.register_warmup(
+                        vllm_config,
+                        hidden_size=self.hidden_size,
+                        hc_mult=self.n,
+                    )
 
     def forward(
         self,
@@ -976,6 +998,21 @@ class Glm5NextModel(nn.Module, EagleModelMixin):
                     )
                     weight_loader(param, loaded_weight, **kwargs)
             loaded_params.add(name)
+        if _mhc_bf16_weights_enabled():
+            from vllm.model_executor.kernels.mhc.tilelang import (
+                register_mhc_bf16_weights,
+            )
+
+            fns = [
+                fn
+                for layer in self._active_layers
+                if layer.mhc and not layer.is_mtp_layer
+                for fn in (layer.hc_attn_fn, layer.hc_ffn_fn)
+            ]
+            n = register_mhc_bf16_weights(fns)
+            logger.info_once(
+                "mHC decode kernel reads %d of %d weights in BF16", n, len(fns)
+            )
         return loaded_params
 
 
