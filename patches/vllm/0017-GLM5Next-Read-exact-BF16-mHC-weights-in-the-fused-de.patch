         _MHC_POST_TILELANG_KERNEL,
         _MHC_PRE_BIG_FUSE_TILELANG_KERNEL,
@@ -912,7 +972,16 @@ def mhc_fused_post_pre_tilelang(
     )
 
     if fused_config is not None:
-        gemm_out_mul, gemm_out_sqrsum, residual_cur = _MHC_FUSED_TILELANG_KERNEL(
+        fused_kernel = _MHC_FUSED_TILELANG_KERNEL
+        fn_bf16 = None
+        # Empty unless GLM-5.3 registered weights. DeepSeek-V4 calls this
+        # function directly, where fn can be a fake tensor with no data_ptr.
+        if _MHC_BF16_WEIGHTS:
