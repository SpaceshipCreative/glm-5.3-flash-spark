index 000000000..c13f5c01c
--- /dev/null
+++ b/vllm/models/glm5next/nvidia/ops/pool_topk.py
@@ -0,0 +1,183 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Run-to-run deterministic pool top-k for the GLM5Next kpool indexer.
+
+The indexer's radix/histogram top-k kernels return the right set of pools,
+but in a launch-dependent order, and when several pools tie at the k-th score
+they keep a launch-dependent subset of the tied pools. The selected pools
+expand to token indices in list order and sparse MLA accumulates keys in that
+order, so either effect changes the rounding of the attention output. The
+next layer's indexer then scores different keys, and identical requests drift
+apart once the context exceeds ``index_topk`` tokens.
+
+``canonicalize_pool_topk`` rewrites a top-k result into one canonical form:
+the exact top-k by score, ties at the k-th score broken toward the lowest
+pool id, listed in ascending id order and -1 padded.
+"""
+
+from __future__ import annotations
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+# Extra candidates requested from a top-k kernel that accepts any k. Ties at
+# the k-th score that fit in the slack are resolved from the candidates alone;
+# longer ties fall back to a scan of the whole row.
+TOPK_TIE_SLACK = 32
+
+_SCAN_BLOCK = 1024
+
+
+@triton.jit
+def _score_sort_key(x):
+    # Reinterpret float32 as int32 so signed integer order matches float order
+    # (negative floats have their magnitude bits flipped).
+    bits = x.to(tl.int32, bitcast=True)
+    return tl.where(bits < 0, bits ^ 0x7FFFFFFF, bits)
+
+
+@triton.jit
+def _pick(values, offs, i):
+    # values[i] of a 1-D block as a scalar.
+    return tl.sum(tl.where(offs == i, values, 0), axis=0)
+
+
+@triton.jit
+def _canonicalize_pool_topk_kernel(
+    cand_ptr,
+    cand_row_stride,
+    logits_ptr,
+    logits_row_stride,
+    logits_col_stride,
+    row_start_ptr,
+    row_end_ptr,
+    out_ptr,
+    out_row_stride,
+    num_cand,
+    k,
+    HAS_ROW_START: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+    SCAN_BLOCK: tl.constexpr,
+):
+    INT32_MAX = 2147483647
+    INT32_MIN = -2147483648
+    row = tl.program_id(0).to(tl.int64)
+    row_end = tl.load(row_end_ptr + row).to(tl.int32)
+    if HAS_ROW_START:
+        row_start = tl.load(row_start_ptr + row).to(tl.int32)
+    else:
+        row_start = row_end - row_end
+    row_len = row_end - row_start
+    score_row = logits_ptr + row * logits_row_stride + row_start * logits_col_stride
+    out_row = out_ptr + row * out_row_stride
+
+    offs = tl.arange(0, BLOCK_C)
+    ids = tl.load(
+        cand_ptr + row * cand_row_stride + offs, mask=offs < num_cand, other=-1
+    )
+    ok = (ids >= 0) & (ids < row_len)
+    n_ok = tl.sum(ok.to(tl.int32), axis=0)
+    score = tl.load(score_row + ids * logits_col_stride, mask=ok, other=0.0)
+    key = tl.where(ok, _score_sort_key(score.to(tl.float32)), INT32_MIN)
+
+    # Score key of the k-th best candidate and of the worst valid candidate.
+    key_desc = tl.sort(key, descending=True)
+    kth_key = _pick(key_desc, offs, k - 1)
+    worst_key = _pick(key_desc, offs, n_ok - 1)
+    above = tl.sum((ok & (key > kth_key)).to(tl.int32), axis=0)
+    need = k - above
+
+    # Pools outside the candidates score at most worst_key. When the k-th score
+    # equals it and the row has pools beyond the candidates, some tied pools
+    # may be missing from the candidates, so rescan the row.
+    rescan = (
+        (n_ok == num_cand) & (row_len > n_ok) & (n_ok >= k) & (kth_key == worst_key)
+    )
+    if rescan:
+        written = tl.zeros((), dtype=tl.int32)
+        ties_left = need
+        for off in range(0, row_len, SCAN_BLOCK):
+            col = off + tl.arange(0, SCAN_BLOCK)
+            in_row = col < row_len
+            col_key = _score_sort_key(
+                tl.load(score_row + col * logits_col_stride, mask=in_row, other=0.0).to(
+                    tl.float32
+                )
+            )
+            is_tie = in_row & (col_key == kth_key)
+            take = (in_row & (col_key > kth_key)) | (
+                is_tie & (tl.cumsum(is_tie.to(tl.int32), axis=0) <= ties_left)
+            )
+            dst = written + tl.cumsum(take.to(tl.int32), axis=0) - 1
+            tl.store(out_row + dst, col, mask=take & (dst < k))
+            written += tl.sum(take.to(tl.int32), axis=0)
+            ties_left -= tl.sum(is_tie.to(tl.int32), axis=0)
+        for off in range(0, k, SCAN_BLOCK):
+            dst = off + tl.arange(0, SCAN_BLOCK)
+            tl.store(
+                out_row + dst,
+                tl.full((SCAN_BLOCK,), -1, tl.int32),
+                mask=(dst >= written) & (dst < k),
+            )
+    else:
+        # Lowest ids win among candidates tied at the k-th score: the need-th
+        # smallest tied id is the cut.
+        tied_ids = tl.sort(tl.where(ok & (key == kth_key), ids, INT32_MAX))
+        tie_cut = _pick(tied_ids, offs, need - 1)
+        keep = ok & (
+            (n_ok <= k) | (key > kth_key) | ((key == kth_key) & (ids <= tie_cut))
+        )
+        kept = tl.sort(tl.where(keep, ids, INT32_MAX))
+        tl.store(out_row + offs, tl.where(kept == INT32_MAX, -1, kept), mask=offs < k)
+
+
+def canonicalize_pool_topk(
+    candidates: torch.Tensor,
+    logits: torch.Tensor,
+    row_starts: torch.Tensor | None,
+    row_ends: torch.Tensor,
+    out: torch.Tensor,
+) -> None:
+    """Write each row's canonical top-k into ``out``.
+
+    Args:
+        candidates: ``[rows, C]`` int32 ids relative to each row's start, the
+            exact top-C of the row in any order, -1 padded. ``C >= k``; ids
+            past ``k`` let ties at the k-th score resolve without a rescan.
+        logits: ``[rows, L]`` float32 scores; row ``r`` covers columns
+            ``[row_starts[r], row_ends[r])``.
+        row_starts: ``[rows]`` int32 first column of each row, or None for 0.
+        row_ends: ``[rows]`` int32 exclusive end column of each row.
+        out: ``[rows, k]`` int32 destination; must not alias ``candidates``.
+            Receives the top-k ids (row-relative) in ascending order, ties at
+            the k-th score going to the lowest ids, -1 padded.
+
+    """
+    rows, num_cand = candidates.shape
+    k = out.shape[1]
+    assert out.shape[0] == rows and logits.shape[0] >= rows
+    assert 0 < k <= num_cand
+    assert candidates.dtype == torch.int32 and out.dtype == torch.int32
+    assert candidates.stride(1) == 1 and out.stride(1) == 1
+    assert row_ends.shape[0] >= rows
+    if rows == 0:
+        return
+    block_c = triton.next_power_of_2(num_cand)
+    _canonicalize_pool_topk_kernel[(rows,)](
+        candidates,
+        candidates.stride(0),
+        logits,
+        logits.stride(0),
+        logits.stride(1),
+        row_ends if row_starts is None else row_starts,
+        row_ends,
+        out,
+        out.stride(0),
+        num_cand,
+        k,
+        HAS_ROW_START=row_starts is not None,
+        BLOCK_C=block_c,
+        SCAN_BLOCK=_SCAN_BLOCK,
+        num_warps=8 if block_c >= 2048 else 4,
+    )
