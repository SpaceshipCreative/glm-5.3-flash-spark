 vllm/models/glm5next/common/kda.py            |  8 +++--
 2 files changed, 32 insertions(+), 7 deletions(-)

diff --git a/vllm/model_executor/layers/mamba/ops/causal_conv1d.py b/vllm/model_executor/layers/mamba/ops/causal_conv1d.py
index e8254e4f3..35ed761ec 100644
--- a/vllm/model_executor/layers/mamba/ops/causal_conv1d.py
+++ b/vllm/model_executor/layers/mamba/ops/causal_conv1d.py
@@ -46,6 +46,7 @@ def _causal_conv1d_fwd_kernel(  # continuous batching
     stride_cache_indices: tl.constexpr,
     stride_o_dim: tl.constexpr,
     stride_o_token: tl.int64,
+    stride_o_group: tl.int64,  # with OUT_GROUP: stride between feature groups
     stride_block_m: tl.constexpr,  # Stride block to align divided by BLOCK_M
     # others
     pad_slot_id: tl.constexpr,
@@ -57,6 +58,7 @@ def _causal_conv1d_fwd_kernel(  # continuous batching
     IS_APC_ENABLED: tl.constexpr,
     HAS_NULL_BLOCK: tl.constexpr,
     NP2_STATELEN: tl.constexpr,
+    OUT_GROUP: tl.constexpr,
     BLOCK_M: tl.constexpr,
     BLOCK_N: tl.constexpr,
     launch_pdl: tl.constexpr,
@@ -469,10 +471,16 @@ def _causal_conv1d_fwd_kernel(  # continuous batching
         mask_1d = (idx_token < segment_len) & (
             idx_feats < dim
         )  # token-index  # feature-index
+        if OUT_GROUP > 0:
+            o_feats = (idx_feats // OUT_GROUP) * stride_o_group + (
+                idx_feats % OUT_GROUP
+            ) * stride_o_dim
+        else:
+            o_feats = idx_feats * stride_o_dim
         o_ptrs = (
             o_ptr
             + (sequence_start_index + token_offset + idx_token) * stride_o_token
-            + (idx_feats * stride_o_dim)
+            + o_feats
         )
 
         tl.store(o_ptrs, acc, mask=mask_1d)
@@ -496,6 +504,7 @@ def causal_conv1d_fn(
     block_size_to_align=0,
     metadata=None,
     validate_data=False,
+    out_group: int = 0,
 ):
     """Support varlen + continuous batching when x is 2D tensor.
 
@@ -546,7 +555,10 @@ def causal_conv1d_fn(
         The number of tokens already completed for each sequence
     block_size_to_align: int
         The block size to align the cached states to
-    out: same shape as `x`
+    out_group: int
+        If nonzero, return (dim // out_group, seqlen, out_group): each group
+        of out_group features as its own dense tensor. x must be 2D.
+    out: same shape as `x`, unless out_group is set
     """
     if isinstance(activation, bool) and activation:
         activation = "silu"
@@ -555,7 +567,13 @@ def causal_conv1d_fn(
     # Store original dtype to cast back at the end
     original_x_dtype = x.dtype
     x = x.to(conv_states.dtype)
-    out = torch.empty_like(x)
+    if out_group:
+        # Output [dim // out_group, seqlen, out_group]: each group of features
+        # (q, k, v of a merged conv) comes out as its own dense tensor.
+        assert x.dim() == 2 and x.shape[0] % out_group == 0
+        out = x.new_empty(x.shape[0] // out_group, x.shape[1], out_group)
+    else:
+        out = torch.empty_like(x)
     if metadata is not None:
         nums_dict = metadata.nums_dict
         args = nums_dict
@@ -604,7 +622,10 @@ def causal_conv1d_fn(
         stride_istate_seq = conv_states.stride(0)
         stride_istate_dim = conv_states.stride(1)
         stride_istate_token = conv_states.stride(2)
-    if out.dim() == 2:
+    stride_o_group = 0
+    if out_group:
+        stride_o_group, stride_o_token, stride_o_dim = out.stride()
+    elif out.dim() == 2:
         stride_o_dim = out.stride(0)
         stride_o_token = out.stride(1)
     else:
@@ -739,6 +760,7 @@ def causal_conv1d_fn(
         stride_cache_indices,
         stride_o_dim,
         stride_o_token,
+        stride_o_group,
         block_size_to_align // BLOCK_M,
         # others
         pad_slot_id,
@@ -750,6 +772,7 @@ def causal_conv1d_fn(
         IS_APC_ENABLED=block_idx_last_scheduled_token is not None,
         HAS_NULL_BLOCK=null_block_id is not None,
         NP2_STATELEN=np2_statelen,
+        OUT_GROUP=out_group,
         # launch_cooperative_grid=True
         BLOCK_M=BLOCK_M,
         BLOCK_N=256,
