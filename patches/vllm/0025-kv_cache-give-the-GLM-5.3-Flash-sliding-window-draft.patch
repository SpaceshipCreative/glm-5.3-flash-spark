+    pool_groups = [group for group in layout[8] if _uses_draft_pool(group)]
+    num_blocks = _glm5_next_draft_pool_blocks(vllm_config, pool_groups)
+    return (num_blocks or 0) * _glm5_next_draft_bytes_per_block(pool_groups)
+
