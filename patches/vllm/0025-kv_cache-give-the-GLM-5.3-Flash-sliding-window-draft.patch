+def _glm5_next_draft_pool_enabled(vllm_config: VllmConfig) -> bool:
+    """Whether a sliding-window drafter on GLM-5.3-Flash gets its own pool.
+
+    Sharing the target's pool costs one page per draft layer in every target
+    block, though a sliding-window layer only ever holds its window: with
+    DFlash2 (5 layers) on a 2304-token block, 30% of the KV cache.
+
+    Gated by VLLM_GLM5NEXT_DRAFT_POOL (default on), and only on the path it is
+    wired for: Model Runner V2 (the runner DFlash2 heads run on; it keeps the
+    pool's ids out of KV zeroing, copy-on-write, warmup and dummy contexts),
+    without a KV connector (which would move or defer-free draft blocks),
+    HiSparse or context parallelism. Otherwise the drafter shares the pool.
+    """
+    parallel_config = vllm_config.parallel_config
+    return (
+        envs.VLLM_GLM5NEXT_DRAFT_POOL
+        and vllm_config.kv_transfer_config is None
+        and vllm_config.attention_config.hisparse_config is None
+        and parallel_config.decode_context_parallel_size == 1
+        and parallel_config.prefill_context_parallel_size == 1
+        and vllm_config.use_v2_model_runner
+    )
+
+
+def _glm5_next_draft_block_size(target_block_size: int) -> int:
+    """Block size of the drafter's pool.
+
+    256 by default when it divides the target block, so a request holds its
+    window in about window / 256 pages rather than two whole target blocks;
+    the target block otherwise. It must divide the target block so the
+    scheduler block (lcm over groups) stays the target's.
+    VLLM_GLM5NEXT_DRAFT_BLOCK_SIZE overrides it.
+    """
+    block_size = envs.VLLM_GLM5NEXT_DRAFT_BLOCK_SIZE
+    if not block_size:
+        return 256 if target_block_size % 256 == 0 else target_block_size
+    if block_size % 16 != 0 or target_block_size % block_size != 0:
+        raise ValueError(
+            f"VLLM_GLM5NEXT_DRAFT_BLOCK_SIZE={block_size} must be a multiple of 16 "
+            f"that divides the target block size {target_block_size}"
+        )
+    return block_size
+
+
+def _glm5_next_draft_pool_blocks(
+    vllm_config: VllmConfig, draft_groups: list[KVCacheGroupSpec]
+) -> int | None:
+    """Blocks in the drafter's own pool, or None when there is none.
+
+    Between steps a running request holds a sliding-window group's window,
+    its lookahead and the tokens it has in flight (blocks leave the window on
+    the processed-token basis), plus a block straddling each end; all requests
+    together have at most ``max_in_flight_tokens`` in flight. On top of
+    ``max_num_seqs`` such windows the pool keeps one request's admission
+    reservation (``max_admission_blocks_per_request``) free, so it does not
+    refuse an admission the target's pool would grant, plus the null block.
+    Draft groups share the pool, so their needs add up.
+    """
+    pool_groups = [group for group in draft_groups if _uses_draft_pool(group)]
+    if not pool_groups:
+        return None
+    max_num_seqs = vllm_config.scheduler_config.max_num_seqs
+    max_in_flight_tokens = vllm_config.max_in_flight_tokens
+    num_lookahead_tokens = vllm_config.num_lookahead_tokens
+    num_blocks = 1
+    for group in pool_groups:
+        spec = cast(
+            DraftSlidingWindowSpec, next(iter(iter_layer_specs(group.kv_cache_spec)))
+        )
+        window = spec.sliding_window - 1 + spec.extra_retained_tokens
+        window_blocks = cdiv(window + num_lookahead_tokens, spec.block_size) + 2
+        num_blocks += (
+            max_num_seqs * window_blocks
+            + max_in_flight_tokens // spec.block_size
+            + spec.max_admission_blocks_per_request(
+                max_in_flight_tokens, vllm_config.model_config.max_model_len
+            )
+        )
+    return num_blocks
+
