+def _uses_draft_pool(group: KVCacheGroupSpec) -> bool:
+    """Whether the group's block ids index the drafter's own pool."""
+    return isinstance(
+        next(iter(iter_layer_specs(group.kv_cache_spec))), DraftSlidingWindowSpec
+    )
+
