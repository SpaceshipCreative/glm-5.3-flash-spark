# Copy to spark.env and edit. spark.sh sources this file.

# SSH targets, rank order (rank 0 serves the API). TP=4 uses the first four from
# NODE_OFFSET, TP=2 the first two; run a second TP=2 instance with NODE_OFFSET=2,
# a different PORT, MASTER_PORT and NAME.
NODES="spark1 spark2 spark3 spark4"
# Each node's address on the ConnectX-7 fabric (same order as NODES).
FABRIC_IPS="10.100.96.1 10.100.96.2 10.100.96.3 10.100.96.4"

TP=4
NODE_OFFSET=0
NAME=glm53
PORT=8000
MASTER_PORT=29500

IMAGE=glm-5.3-flash-spark:v0.31.0
SERVED_NAME=glm-5.3-flash
# Host paths, identical on every node. Weights: nvidia/GLM-5.3-Flash-NVFP4 @ da920bb and
# incoai/GLM-5.3-Flash-DFlash2 @ bf582e4 (see README). For lossless8, point MODEL_DIR at
# the tools/lossless8.py output.
MODEL_DIR=/models/GLM-5.3-Flash-NVFP4
DRAFT_DIR=/models/GLM-5.3-Flash-DFlash2
CACHE_DIR=/var/cache/glm53

# RoCE: both ConnectX-7 PCIe roots, each with an IPv4 in its own subnet, MTU 9000.
# Device names are the same on every Spark; f0 vs f1 depends on which port is cabled.
NCCL_IB_HCA=rocep1s0f0,roceP2p1s0f0
FABRIC_IF=enp1s0f0np0
NCCL_MAX_NCHANNELS=8      # 8 at TP=4 (Kindling); try 4 at TP=2 (MiaAI, two nodes)
# Leave unset so NCCL picks the RoCE v2 IPv4 GID itself; it moves across reboots.
# NCCL_IB_GID_INDEX=

# W4A16 Marlin by default. flashinfer_cutlass is W4A4 (faster prefill, but static
# input-scale clipping); b12x needs --build-arg B12X_VERSION=1.5.0 and, for W4A16,
# EXTRA_ENV=VLLM_B12X_MOE_FP4_FORCE_A16=1. Switch only after the KL gate passes.
MOE_BACKEND=marlin
# DFlash2 draft length; 0 = no speculation. Sweep 0/3/5/7 at your concurrency.
SPEC_K=7
# k by running batch size (A/B; untested with RecoverSSM): SPEC_TABLE='[[1,1,7],[2,2,5],[3,64,3]]'
# Sparse MLA: the SM90 backend on FlashInfer FA2 (patched for sm_121) with fp8_e4m3 KV,
# dense MHA prefill and the Triton sparse prefill. A/B against stock with
# ATTN_BACKEND=FLASHINFER_MLA_SPARSE_SM120 (it converts the MLA KV to fp8_ds_mla itself).
ATTN_BACKEND=FLASHINFER_MLA_SPARSE_SM90
KV_CACHE_DTYPE=fp8_e4m3

# Per-TP defaults live in spark.sh; uncomment to override.
# KV_CACHE_BYTES=27917287424
# MAX_MODEL_LEN=524288
# MAX_NUM_SEQS=64
# MAX_BATCHED=16384

# 1 = drop page cache and compact memory before boot (needs passwordless sudo).
DROP_CACHES=0
# Extra vllm serve flags and container env, space-separated.
EXTRA_ARGS=""
# e.g. at TP=2: VLLM_TRITON_SPARSE_MLA_PREFILL_CFG=64,8,1,1 (tuned at TP=4 as 64,4,1,1)
EXTRA_ENV=""
